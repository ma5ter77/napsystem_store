# Copy to .env. Everything works in demo mode without any external secrets.
NAP_ENV=demo
NAP_SECRET_KEY=change-me-long-random
POSTGRES_PASSWORD=nap
NAP_PUBLIC_BASE_URL=http://localhost:3000

# Payments: mock (default) or stripe (test keys sk_test_..., webhook whsec_...)
NAP_PAYMENT_PROVIDER=mock
NAP_STRIPE_SECRET_KEY=
NAP_STRIPE_WEBHOOK_SECRET=
NAP_PLATFORM_COMMISSION_BPS=3000
NAP_PAYOUT_HOLD_DAYS=0
NAP_SUBSCRIPTION_GRACE_DAYS=0

# Shipping: mock (default) | manual | easypost (test key EZTK...)
NAP_SHIPPING_ADAPTER=mock
NAP_EASYPOST_API_KEY=
NAP_EASYPOST_WEBHOOK_SECRET=

# Converter limits (shown to authors before upload)
NAP_MAX_UPLOAD_BYTES=1073741824
NAP_MAX_DURATION_SECONDS=7200
NAP_PREVIEW_SECONDS=30

# E-mail (NAP-007): log | file | smtp. For smtp set the provider's host, port, login and password.
NAP_EMAIL_BACKEND=log
NAP_EMAIL_FROM=NAP Store <no-reply@example.com>
NAP_SMTP_HOST=
NAP_SMTP_PORT=587
NAP_SMTP_USER=
NAP_SMTP_PASSWORD=
NAP_SMTP_SECURITY=starttls

# Telegram channel posts (NAP-118). Admin -> News. Without the bot token and channel, drafts work and sending waits.
# The bot must be an administrator of the channel with the right to post. Without the model key, drafts use a template.
NAP_TELEGRAM_BOT_TOKEN=
NAP_TELEGRAM_CHANNEL=
NAP_ANTHROPIC_API_KEY=
# NAP_ANTHROPIC_MODEL=claude-haiku-5-5

# Secure Player (NAP-104): protected .napx packages and offline leases. Unset = derived from NAP_SECRET_KEY.
# Fresh values: cd backend && uv run python -m app.tools.secure_keys. Changing them later makes downloaded copies
# unreadable (listeners download again).
# NAP_CONTENT_MASTER_KEY=
# NAP_LICENSE_SIGNING_KEY=
# NAP_LICENSE_OFFLINE_DAYS=30
# NAP_LICENSE_MAX_DEVICES=5

# File storage (NAP-004): local volume (default) or a private S3 bucket.
# Bundled SeaweedFS: uncomment both lines below and set your own long random keys.
# External S3 (Hetzner, Backblaze, AWS, Yandex...): NAP_STORAGE_BACKEND=s3 + endpoint/bucket/keys, no profile.
# COMPOSE_PROFILES=s3
# NAP_STORAGE_BACKEND=s3
NAP_S3_ENDPOINT_URL=http://s3:8333
NAP_S3_BUCKET=nap-private
NAP_S3_REGION=us-east-1
NAP_S3_ACCESS_KEY=nap-local-access
NAP_S3_SECRET_KEY=nap-local-secret-change-me

# Public server only (ops/vps sets NAP_PUBLIC_DEMO=true): demo accounts get the server's own password,
# derived from NAP_SECRET_KEY unless NAP_DEMO_PASSWORD is set. Print it: python -m app.tools.demo_password
# NAP_PUBLIC_DEMO=false
# NAP_DEMO_PASSWORD=
# NAP_SEED_DEMO=1            # 0 before real customers (with NAP_ENV=production)

# Backups (backup service): daily at BACKUP_AT (UTC), dumps kept BACKUP_KEEP_DAYS, full file archives kept
# BACKUP_STORAGE_KEEP_DAYS; an archive that would leave less than BACKUP_MIN_FREE_PCT of the disk free is skipped
# and reported as failed.
BACKUP_AT=23:30
BACKUP_KEEP_DAYS=14
BACKUP_STORAGE_KEEP_DAYS=2
BACKUP_MIN_FREE_PCT=10

# Accepted currencies (EUR/USD by default; add "RUB" only together with YooKassa keys)
# NAP_CURRENCIES=["EUR","USD"]
