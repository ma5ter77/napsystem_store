# Copy to .env. Everything works in demo mode without any external secrets.
NAP_ENV=demo
NAP_SECRET_KEY=change-me-long-random
POSTGRES_PASSWORD=nap
NAP_PUBLIC_BASE_URL=http://localhost:3000

# Payments: mock (default) or stripe (test keys sk_test_..., webhook whsec_...)
NAP_PAYMENT_PROVIDER=mock
NAP_STRIPE_SECRET_KEY=
NAP_STRIPE_WEBHOOK_SECRET=
NAP_PLATFORM_COMMISSION_BPS=3000
NAP_PAYOUT_HOLD_DAYS=0
NAP_SUBSCRIPTION_GRACE_DAYS=0

# Shipping: mock (default) | manual | easypost (test key EZTK...)
NAP_SHIPPING_ADAPTER=mock
NAP_EASYPOST_API_KEY=
NAP_EASYPOST_WEBHOOK_SECRET=

# Converter limits (shown to authors before upload)
NAP_MAX_UPLOAD_BYTES=1073741824
NAP_MAX_DURATION_SECONDS=7200
NAP_PREVIEW_SECONDS=30

# E-mail (NAP-007): log | file | smtp. For smtp set the provider's host, port, login and password.
NAP_EMAIL_BACKEND=log
NAP_EMAIL_FROM=NAP Store <no-reply@example.com>
NAP_SMTP_HOST=
NAP_SMTP_PORT=587
NAP_SMTP_USER=
NAP_SMTP_PASSWORD=
NAP_SMTP_SECURITY=starttls

# File storage (NAP-004): local volume (default) or a private S3 bucket.
# Bundled SeaweedFS: uncomment both lines below and set your own long random keys.
# External S3 (Hetzner, Backblaze, AWS, Yandex...): NAP_STORAGE_BACKEND=s3 + endpoint/bucket/keys, no profile.
# COMPOSE_PROFILES=s3
# NAP_STORAGE_BACKEND=s3
NAP_S3_ENDPOINT_URL=http://s3:8333
NAP_S3_BUCKET=nap-private
NAP_S3_REGION=us-east-1
NAP_S3_ACCESS_KEY=nap-local-access
NAP_S3_SECRET_KEY=nap-local-secret-change-me
