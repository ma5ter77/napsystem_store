# Additions to .env for store.napsystem.com (copy .env.example to /srv/nap-store/shared/.env, then add these).
# Values are written by the owner on the server — never sent in chat, Telegram or git.
NAP_PUBLIC_BASE_URL=https://store.napsystem.com
STORE_WEB_PORT=3100
NAP_COOKIE_SECURE=true
# demo mode keeps test payments (mock) until live keys are connected (NAP-010/012)
NAP_ENV=demo
# NAP_SECRET_KEY, POSTGRES_PASSWORD: long random values, e.g. `openssl rand -hex 32`
# E-mail: NAP_EMAIL_BACKEND=smtp + NAP_SMTP_* when the mailbox is ready
